# Copy this file to .env and fill in the values. .env is gitignored.
#
#   cp .env.example .env
#
# Keys are read in src/config.py. On Linux and macOS the names are
# case-sensitive, so they must match exactly as written here.

# Where the frontend runs. Used for the CORS allow-list.
ORIGIN=http://localhost:5173

# Signs the JWTs. Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use a different value in every environment, and never commit the real one.
SECRET_KEY=replace-me-with-a-long-random-string

# SQLAlchemy connection URL. The default is a local SQLite file, created by
# `alembic upgrade head`.
DB_URL=sqlite:///./test.db

# JWT signing algorithm. HS256 goes with the shared SECRET_KEY above.
ALGORITHM=HS256
