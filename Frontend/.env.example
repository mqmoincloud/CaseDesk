# Copy this file to .env if the API is not on the default address.
#
#   cp .env.example .env
#
# Vite only exposes variables that start with VITE_, and it reads them at
# build time - restart `npm run dev` after changing this.

# Where the FastAPI backend is listening. Leave it out and the app falls back
# to this same value.
VITE_API_URL=http://127.0.0.1:8000
